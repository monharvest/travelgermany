// Cloudflare Worker with static assets (replaced Cloudflare Pages, 2026-11).
// `npm run build` writes dist/; `npx wrangler deploy` uploads it with
// worker/index.js, which only sees /blog and /blog/ (the legacy ?post= 301s);
// every other request is a file, a _redirects rule or the 404 page.
// public/_redirects and public/_headers apply as they did on Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelgermany",
  "account_id": "01644e982bf4fd61e45c31c2dc1a2a57",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/blog", "/blog/"]
  },
  // travelgermany.info is served through this route (www -> apex and http ->
  // https are zone rules). workers.dev is off: a second public copy of the site.
  "routes": [{ "pattern": "travelgermany.info/*", "zone_name": "travelgermany.info" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
