# The headers Cloudflare Pages added to every response by default; a Worker
# serving static assets does not, so they are set here to keep responses the same.
/*
  Access-Control-Allow-Origin: *
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# On Pages the zone's 4-hour Browser Cache TTL covered images, CSS and
# robots.txt. It does not apply to a Worker's responses, so it is set here.
/_astro/*
  Cache-Control: public, max-age=14400, must-revalidate
/wp-content/*
  Cache-Control: public, max-age=14400, must-revalidate
/images/*
  Cache-Control: public, max-age=14400, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=14400, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=14400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=14400, must-revalidate
