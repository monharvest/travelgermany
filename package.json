{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "import:wp": "node scripts/import-wordpress.mjs",
    "sync:uploads": "mkdir -p public/wp-content && rsync -a --delete ../wpclone_backup/wp-content/uploads/ public/wp-content/uploads/",
    "prepare:content": "npm run import:wp && npm run sync:uploads",
    "build": "astro build && node scripts/write-slash-redirects.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
